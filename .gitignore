# Install manifests, written into whatever directory the kit installs to.
# Only appears here if someone runs a project-scope install on the kit itself.
.agent-delegation-kit.json

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Local scratch
/tmp/
*.local.json

# Local, machine-specific overrides. These can hold employer model policy and
# internal usage figures, so they must never be committed to this public repo.
registry/*.local.json
build/local/
build/last-build.json
